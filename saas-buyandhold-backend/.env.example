# Configurações do servidor
PORT=5000
NODE_ENV=development

# Configurações de email (Gmail)
# Para usar Gmail, você precisa:
# 1. Ativar autenticação de 2 fatores na sua conta Google
# 2. Gerar uma senha de app específica para esta aplicação
# 3. Usar essa senha de app no EMAIL_PASS
EMAIL_USER=seu-email@gmail.com
EMAIL_PASS=sua-senha-de-app-do-gmail
EMAIL_FROM=Buy & Hold <noreply@buyandhold.com>
EMAIL_TO=ajuda.brugnara@gmail.com

# Outras configurações (definidas automaticamente pelo sistema)
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
# JWT_SECRET, SESSION_SECRET
# PIX_KEY, PIX_BANK_CODE
# MERCADO_PAGO_ACCESS_TOKEN, MERCADO_PAGO_PUBLIC_KEY
