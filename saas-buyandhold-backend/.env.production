# Configurações de Produção - Backend

# URLs
FRONTEND_URL=https://buyandhold.vargascode.com.br
BACKEND_URL=https://buyandhold.vargascode.com.br/api

# Servidor
PORT=5000
NODE_ENV=production

# Banco de Dados (ajustar conforme sua configuração de produção)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buyandhold_prod
DB_USER=buyandhold_user
DB_PASSWORD=sua_senha_segura_aqui

# JWT
JWT_SECRET=sua_chave_jwt_super_secreta_para_producao
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://buyandhold.vargascode.com.br

# Logs
LOG_LEVEL=info
LOG_FILE=logs/app.log

# PIX/Pagamentos (ajustar com suas chaves de produção)
PIX_KEY=sua_chave_pix_producao
MERCADO_PAGO_ACCESS_TOKEN=sua_chave_mercado_pago_producao
MERCADO_PAGO_PUBLIC_KEY=sua_chave_publica_mercado_pago_producao

# SSL/HTTPS
SSL_ENABLED=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=sua_chave_de_sessao_super_secreta_para_producao